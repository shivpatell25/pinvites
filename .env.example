# Copy this file to .env and replace every blank secret before starting Pinvites.
# Never commit .env.

# Docker / PostgreSQL
APP_PORT=3000
POSTGRES_DB=pinvites
POSTGRES_USER=pinvites
POSTGRES_PASSWORD=
# The password in DATABASE_URL must be URL-encoded if it contains reserved URL characters.
DATABASE_URL=
RUN_MIGRATIONS=true

# Public application origin. Production requires HTTPS and no trailing path.
BASE_URL=https://invites.example.com
# Generate with: openssl rand -hex 32
APP_SECRET=
MEDIA_ROOT=/app/data/media
MAX_UPLOAD_MB=15

# Authentication and reverse-proxy trust
SESSION_COOKIE_NAME=pinvites_session
SESSION_ABSOLUTE_TTL_HOURS=168
SESSION_IDLE_TTL_MINUTES=1440
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_BLOCK_MINUTES=30
RSVP_RATE_LIMIT_WINDOW_MINUTES=10
RSVP_RATE_LIMIT_MAX_ATTEMPTS=20
RSVP_RATE_LIMIT_BLOCK_MINUTES=10
# Enable only when the application port is reachable exclusively through a trusted proxy.
TRUST_PROXY_HEADERS=true
# Comma-separated exact origins allowed to submit state-changing requests, if any beyond BASE_URL.
TRUSTED_ORIGINS=

# One-time administrator bootstrap. Prefer entering these interactively with
# `docker compose run --rm app pnpm admin:create`; do not leave a password here.
# PINVITES_ADMIN_EMAIL=
# PINVITES_ADMIN_NAME=
# PINVITES_ADMIN_PASSWORD=

# Generic SMTP. Leave every SMTP value unset if email is intentionally disabled.
# Pinvites reports SMTP as unavailable and never records a fake successful send.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Pinvites <invites@example.com>
# SMTP_REPLY_TO=host@example.com
# SMTP_REQUIRE_TLS=true
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# SMTP_CONNECTION_TIMEOUT_MS=15000
# SMTP_GREETING_TIMEOUT_MS=15000
# SMTP_SOCKET_TIMEOUT_MS=60000
# SMTP_MAX_CONNECTIONS=3
# SMTP_MAX_MESSAGES_PER_CONNECTION=100
