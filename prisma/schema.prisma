generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  OWNER
  ADMIN
}

enum LoginAttemptOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  RATE_LIMITED
  INACTIVE_ACCOUNT
  ERROR
}

enum RateLimitScope {
  EMAIL
  IP
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ArtworkKind {
  HERO
  GALLERY
}

enum InvitationStatus {
  CREATED
  QUEUED
  SENT
  FAILED
  REVOKED
}

enum InvitationTokenType {
  INVITATION
  MANAGEMENT
}

enum RsvpResponse {
  YES
  MAYBE
  NO
}

enum RsvpSource {
  INVITATION
  PUBLIC_EVENT
  ADMIN
}

enum AttendanceStatus {
  CONFIRMED
  MAYBE
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_SELECT
  MULTI_SELECT
  BOOLEAN
}

enum QuestionScope {
  HOUSEHOLD
  ATTENDEE
}

enum QuestionConditionOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  NOT_CONTAINS
  IS_ANSWERED
  IS_NOT_ANSWERED
}

enum EmailType {
  INVITATION
  REMINDER
  CONFIRMATION
  RSVP_UPDATE
  MANAGEMENT_LINK
  ADMIN_INVITE
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum EmailAttemptStatus {
  STARTED
  SENT
  FAILED
}

enum AnalyticsEventType {
  PUBLIC_EVENT_VIEWED
  INVITATION_OPENED
  RSVP_STARTED
  RSVP_SUBMITTED
  RSVP_UPDATED
  CALENDAR_DOWNLOADED
  QR_CODE_OPENED
}

model Admin {
  id                String           @id @default(uuid()) @db.Uuid
  email             String           @unique @db.VarChar(320)
  normalizedEmail   String           @unique @map("normalized_email") @db.VarChar(320)
  displayName       String           @map("display_name") @db.VarChar(120)
  passwordHash      String           @map("password_hash") @db.Text
  role              AdminRole        @default(ADMIN)
  isActive          Boolean          @default(true) @map("is_active")
  passwordChangedAt DateTime         @default(now()) @map("password_changed_at")
  lastLoginAt       DateTime?        @map("last_login_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  sessions          AdminSession[]
  loginAttempts     LoginAttempt[]
  eventsCreated     Event[]          @relation("EventCreatedBy")
  eventsUpdated     Event[]          @relation("EventUpdatedBy")
  artworkUploads    EventArtwork[]   @relation("ArtworkUploadedBy")
  rsvpSubmissions   RsvpSubmission[]
  auditLogs         AuditLog[]
  invitesSent       AdminInvite[]    @relation("AdminInviteSender")
  acceptedInvite    AdminInvite?     @relation("AdminInviteAcceptedAdmin")

  @@index([isActive, createdAt])
  @@map("admins")
}

model AdminInvite {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @db.VarChar(320)
  normalizedEmail String    @map("normalized_email") @db.VarChar(320)
  displayName     String    @map("display_name") @db.VarChar(120)
  role            AdminRole @default(ADMIN)
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime  @map("expires_at")
  sentAt          DateTime? @map("sent_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  deliveryVersion Int       @default(1) @map("delivery_version")
  lastError       String?   @map("last_error") @db.Text
  invitedById     String    @map("invited_by_id") @db.Uuid
  acceptedAdminId String?   @unique @map("accepted_admin_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  invitedBy       Admin     @relation("AdminInviteSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedAdmin   Admin?    @relation("AdminInviteAcceptedAdmin", fields: [acceptedAdminId], references: [id], onDelete: SetNull)

  @@index([normalizedEmail, acceptedAt, revokedAt])
  @@index([invitedById, createdAt])
  @@index([expiresAt])
  @@map("admin_invites")
}

model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  adminId       String    @map("admin_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  ipHash        String?   @map("ip_hash") @db.Char(64)
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  expiresAt     DateTime  @map("expires_at")
  idleExpiresAt DateTime  @map("idle_expires_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  admin         Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([idleExpiresAt])
  @@map("admin_sessions")
}

model LoginAttempt {
  id          String              @id @default(uuid()) @db.Uuid
  adminId     String?             @map("admin_id") @db.Uuid
  emailHash   String              @map("email_hash") @db.Char(64)
  ipHash      String              @map("ip_hash") @db.Char(64)
  outcome     LoginAttemptOutcome
  attemptedAt DateTime            @default(now()) @map("attempted_at")
  admin       Admin?              @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([emailHash, attemptedAt])
  @@index([ipHash, attemptedAt])
  @@index([outcome, attemptedAt])
  @@map("login_attempts")
}

model LoginRateLimitBucket {
  id              String         @id @default(uuid()) @db.Uuid
  scope           RateLimitScope
  keyHash         String         @map("key_hash") @db.Char(64)
  failureCount    Int            @default(0) @map("failure_count")
  windowStartedAt DateTime       @default(now()) @map("window_started_at")
  blockedUntil    DateTime?      @map("blocked_until")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([scope, keyHash])
  @@index([blockedUntil])
  @@index([updatedAt])
  @@map("login_rate_limit_buckets")
}

model PublicRsvpRateLimitBucket {
  keyHash         String    @id @map("key_hash") @db.Char(64)
  attemptCount    Int       @default(0) @map("attempt_count")
  windowStartedAt DateTime  @default(now()) @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([blockedUntil])
  @@index([updatedAt])
  @@map("public_rsvp_rate_limit_buckets")
}

model Event {
  id                  String           @id @default(uuid()) @db.Uuid
  slug                String           @unique @db.VarChar(120)
  title               String           @db.VarChar(200)
  subtitle            String?          @db.VarChar(240)
  hostName            String           @map("host_name") @db.VarChar(160)
  description         String?          @db.Text
  details             String?          @db.Text
  timezone            String           @db.VarChar(100)
  startsAt            DateTime         @map("starts_at")
  endsAt              DateTime?        @map("ends_at")
  isAllDay            Boolean          @default(false) @map("is_all_day")
  rsvpDeadline        DateTime?        @map("rsvp_deadline")
  status              EventStatus      @default(DRAFT)
  isPublic            Boolean          @default(false) @map("is_public")
  partySizeLimit      Int              @default(1) @map("party_size_limit")
  allowPlusOne        Boolean          @default(false) @map("allow_plus_one")
  allowMaybe          Boolean          @default(true) @map("allow_maybe")
  venueName           String?          @map("venue_name") @db.VarChar(200)
  venueAddress        String?          @map("venue_address") @db.Text
  venueUrl            String?          @map("venue_url") @db.VarChar(2048)
  latitude            Decimal?         @db.Decimal(9, 6)
  longitude           Decimal?         @db.Decimal(9, 6)
  dressCode           String?          @map("dress_code") @db.VarChar(160)
  primaryColor        String?          @map("primary_color") @db.VarChar(9)
  heroArtworkId       String?          @unique @map("hero_artwork_id") @db.Uuid
  publishedAt         DateTime?        @map("published_at")
  closedAt            DateTime?        @map("closed_at")
  archivedAt          DateTime?        @map("archived_at")
  deliveryLockId      String?          @map("delivery_lock_id") @db.Uuid
  deliveryLockedUntil DateTime?        @map("delivery_locked_until")
  createdById         String           @map("created_by_id") @db.Uuid
  updatedById         String?          @map("updated_by_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  createdBy           Admin            @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           Admin?           @relation("EventUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  heroArtwork         EventArtwork?    @relation("EventHeroArtwork", fields: [heroArtworkId], references: [id], onDelete: SetNull)
  artwork             EventArtwork[]   @relation("EventArtworkOwner")
  households          Household[]
  mealOptions         MealOption[]
  questions           Question[]
  emailLogs           EmailLog[]
  analyticsEvents     AnalyticsEvent[]
  auditLogs           AuditLog[]

  @@index([status, startsAt])
  @@index([isPublic, status])
  @@index([createdAt])
  @@index([deliveryLockedUntil])
  @@map("events")
}

model EventArtwork {
  id             String      @id @default(uuid()) @db.Uuid
  eventId        String      @map("event_id") @db.Uuid
  kind           ArtworkKind @default(GALLERY)
  storageKey     String      @unique @map("storage_key") @db.VarChar(500)
  originalName   String      @map("original_name") @db.VarChar(255)
  mimeType       String      @map("mime_type") @db.VarChar(100)
  byteSize       Int         @map("byte_size")
  checksumSha256 String      @map("checksum_sha256") @db.Char(64)
  width          Int
  height         Int
  altText        String?     @map("alt_text") @db.VarChar(300)
  focalPointX    Float       @default(0.5) @map("focal_point_x")
  focalPointY    Float       @default(0.5) @map("focal_point_y")
  sortOrder      Int         @default(0) @map("sort_order")
  uploadedById   String?     @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  event          Event       @relation("EventArtworkOwner", fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy     Admin?      @relation("ArtworkUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  heroFor        Event?      @relation("EventHeroArtwork")

  @@index([eventId, kind, sortOrder])
  @@map("event_artwork")
}

model Household {
  id                  String           @id @default(uuid()) @db.Uuid
  eventId             String           @map("event_id") @db.Uuid
  externalId          String?          @map("external_id") @db.VarChar(120)
  displayName         String           @map("display_name") @db.VarChar(200)
  contactName         String           @map("contact_name") @db.VarChar(160)
  contactEmail        String?          @map("contact_email") @db.VarChar(320)
  normalizedEmail     String?          @map("normalized_email") @db.VarChar(320)
  contactPhone        String?          @map("contact_phone") @db.VarChar(40)
  partySizeLimit      Int              @default(1) @map("party_size_limit")
  allowPlusOne        Boolean          @default(false) @map("allow_plus_one")
  notes               String?          @db.Text
  tags                String[]         @default([])
  archivedAt          DateTime?        @map("archived_at")
  deliveryLockId      String?          @map("delivery_lock_id") @db.Uuid
  deliveryLockedUntil DateTime?        @map("delivery_locked_until")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  event               Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests              Guest[]
  invitation          Invitation?
  rsvp                Rsvp?
  emailLogs           EmailLog[]
  analyticsEvents     AnalyticsEvent[]

  @@unique([eventId, externalId])
  @@index([eventId, normalizedEmail])
  @@index([eventId, displayName])
  @@index([eventId, archivedAt, createdAt])
  @@index([deliveryLockedUntil])
  @@map("households")
}

model Guest {
  id              String     @id @default(uuid()) @db.Uuid
  householdId     String     @map("household_id") @db.Uuid
  fullName        String     @map("full_name") @db.VarChar(160)
  email           String?    @db.VarChar(320)
  normalizedEmail String?    @map("normalized_email") @db.VarChar(320)
  isPrimary       Boolean    @default(false) @map("is_primary")
  isMinor         Boolean    @default(false) @map("is_minor")
  sortOrder       Int        @default(0) @map("sort_order")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  household       Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  attendeeRecords Attendee[]

  @@index([householdId, sortOrder])
  @@index([normalizedEmail])
  @@map("guests")
}

model Invitation {
  id              String            @id @default(uuid()) @db.Uuid
  householdId     String            @unique @map("household_id") @db.Uuid
  status          InvitationStatus  @default(CREATED)
  queuedAt        DateTime?         @map("queued_at")
  sentAt          DateTime?         @map("sent_at")
  failedAt        DateTime?         @map("failed_at")
  revokedAt       DateTime?         @map("revoked_at")
  firstOpenedAt   DateTime?         @map("first_opened_at")
  lastOpenedAt    DateTime?         @map("last_opened_at")
  openCount       Int               @default(0) @map("open_count")
  respondedAt     DateTime?         @map("responded_at")
  lastReminderAt  DateTime?         @map("last_reminder_at")
  reminderCount   Int               @default(0) @map("reminder_count")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  household       Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tokens          InvitationToken[]
  rsvp            Rsvp?
  submissions     RsvpSubmission[]
  emailLogs       EmailLog[]
  analyticsEvents AnalyticsEvent[]

  @@index([status, sentAt])
  @@index([respondedAt])
  @@map("invitations")
}

model InvitationToken {
  id           String              @id @default(uuid()) @db.Uuid
  invitationId String              @map("invitation_id") @db.Uuid
  type         InvitationTokenType
  tokenHash    String              @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime?           @map("expires_at")
  lastUsedAt   DateTime?           @map("last_used_at")
  revokedAt    DateTime?           @map("revoked_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  invitation   Invitation          @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, type, revokedAt])
  @@index([expiresAt])
  @@map("invitation_tokens")
}

model Rsvp {
  id              String           @id @default(uuid()) @db.Uuid
  householdId     String           @unique @map("household_id") @db.Uuid
  invitationId    String?          @unique @map("invitation_id") @db.Uuid
  response        RsvpResponse
  message         String?          @db.Text
  contactEmail    String?          @map("contact_email") @db.VarChar(320)
  revision        Int              @default(1)
  submittedAt     DateTime         @default(now()) @map("submitted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitation      Invitation?      @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  attendees       Attendee[]
  answers         RsvpAnswer[]
  submissions     RsvpSubmission[]
  emailLogs       EmailLog[]
  analyticsEvents AnalyticsEvent[]

  @@index([response, submittedAt])
  @@index([updatedAt])
  @@map("rsvps")
}

model RsvpSubmission {
  id                     String       @id @default(uuid()) @db.Uuid
  rsvpId                 String       @map("rsvp_id") @db.Uuid
  invitationId           String?      @map("invitation_id") @db.Uuid
  actorAdminId           String?      @map("actor_admin_id") @db.Uuid
  revision               Int
  source                 RsvpSource
  response               RsvpResponse
  confirmedAttendeeCount Int          @default(0) @map("confirmed_attendee_count")
  maybeAttendeeCount     Int          @default(0) @map("maybe_attendee_count")
  message                String?      @db.Text
  ipHash                 String?      @map("ip_hash") @db.Char(64)
  userAgent              String?      @map("user_agent") @db.VarChar(512)
  submittedAt            DateTime     @default(now()) @map("submitted_at")
  rsvp                   Rsvp         @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  invitation             Invitation?  @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  actorAdmin             Admin?       @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@unique([rsvpId, revision])
  @@index([submittedAt])
  @@index([invitationId, submittedAt])
  @@map("rsvp_submissions")
}

model Attendee {
  id                  String           @id @default(uuid()) @db.Uuid
  rsvpId              String           @map("rsvp_id") @db.Uuid
  guestId             String?          @map("guest_id") @db.Uuid
  fullName            String           @map("full_name") @db.VarChar(160)
  status              AttendanceStatus
  mealOptionId        String?          @map("meal_option_id") @db.Uuid
  dietaryRestrictions String?          @map("dietary_restrictions") @db.Text
  isPlusOne           Boolean          @default(false) @map("is_plus_one")
  sortOrder           Int              @default(0) @map("sort_order")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  rsvp                Rsvp             @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  guest               Guest?           @relation(fields: [guestId], references: [id], onDelete: SetNull)
  mealOption          MealOption?      @relation(fields: [mealOptionId], references: [id], onDelete: SetNull)
  answers             RsvpAnswer[]

  @@unique([rsvpId, guestId])
  @@index([rsvpId, status])
  @@index([mealOptionId, status])
  @@map("attendees")
}

model MealOption {
  id          String     @id @default(uuid()) @db.Uuid
  eventId     String     @map("event_id") @db.Uuid
  name        String     @db.VarChar(120)
  description String?    @db.VarChar(300)
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendees   Attendee[]

  @@unique([eventId, name])
  @@index([eventId, isActive, sortOrder])
  @@map("meal_options")
}

model Question {
  id                  String              @id @default(uuid()) @db.Uuid
  eventId             String              @map("event_id") @db.Uuid
  prompt              String              @db.VarChar(300)
  helpText            String?             @map("help_text") @db.VarChar(500)
  type                QuestionType
  scope               QuestionScope
  isRequired          Boolean             @default(false) @map("is_required")
  isActive            Boolean             @default(true) @map("is_active")
  sortOrder           Int                 @default(0) @map("sort_order")
  visibleForResponses RsvpResponse[]      @default([YES, MAYBE]) @map("visible_for_responses")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  event               Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  options             QuestionOption[]
  answers             RsvpAnswer[]
  conditions          QuestionCondition[] @relation("ConditionTargetQuestion")
  dependentConditions QuestionCondition[] @relation("ConditionSourceQuestion")

  @@index([eventId, isActive, sortOrder])
  @@map("questions")
}

model QuestionOption {
  id               String              @id @default(uuid()) @db.Uuid
  questionId       String              @map("question_id") @db.Uuid
  label            String              @db.VarChar(200)
  sortOrder        Int                 @default(0) @map("sort_order")
  isActive         Boolean             @default(true) @map("is_active")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  question         Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers          RsvpAnswerOption[]
  conditionMatches QuestionCondition[]

  @@unique([questionId, label])
  @@index([questionId, isActive, sortOrder])
  @@map("question_options")
}

model QuestionCondition {
  id               String                    @id @default(uuid()) @db.Uuid
  questionId       String                    @map("question_id") @db.Uuid
  sourceQuestionId String                    @map("source_question_id") @db.Uuid
  operator         QuestionConditionOperator
  optionId         String?                   @map("option_id") @db.Uuid
  textValue        String?                   @map("text_value") @db.Text
  booleanValue     Boolean?                  @map("boolean_value")
  sortOrder        Int                       @default(0) @map("sort_order")
  question         Question                  @relation("ConditionTargetQuestion", fields: [questionId], references: [id], onDelete: Cascade)
  sourceQuestion   Question                  @relation("ConditionSourceQuestion", fields: [sourceQuestionId], references: [id], onDelete: Cascade)
  option           QuestionOption?           @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([questionId, sortOrder])
  @@index([sourceQuestionId])
  @@map("question_conditions")
}

model RsvpAnswer {
  id           String             @id @default(uuid()) @db.Uuid
  rsvpId       String             @map("rsvp_id") @db.Uuid
  questionId   String             @map("question_id") @db.Uuid
  attendeeId   String?            @map("attendee_id") @db.Uuid
  subjectKey   String             @map("subject_key") @db.VarChar(36)
  textValue    String?            @map("text_value") @db.Text
  booleanValue Boolean?           @map("boolean_value")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  rsvp         Rsvp               @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  question     Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attendee     Attendee?          @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  options      RsvpAnswerOption[]

  @@unique([rsvpId, questionId, subjectKey])
  @@index([questionId])
  @@index([attendeeId])
  @@map("rsvp_answers")
}

model RsvpAnswerOption {
  answerId String         @map("answer_id") @db.Uuid
  optionId String         @map("option_id") @db.Uuid
  answer   RsvpAnswer     @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option   QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([answerId, optionId])
  @@index([optionId])
  @@map("rsvp_answer_options")
}

model EmailLog {
  id                    String                 @id @default(uuid()) @db.Uuid
  eventId               String?                @map("event_id") @db.Uuid
  householdId           String?                @map("household_id") @db.Uuid
  invitationId          String?                @map("invitation_id") @db.Uuid
  rsvpId                String?                @map("rsvp_id") @db.Uuid
  type                  EmailType
  status                EmailStatus            @default(QUEUED)
  toEmail               String                 @map("to_email") @db.VarChar(320)
  fromEmail             String?                @map("from_email") @db.VarChar(320)
  replyTo               String?                @map("reply_to") @db.VarChar(320)
  subject               String                 @db.VarChar(300)
  idempotencyKey        String                 @unique @map("idempotency_key") @db.VarChar(200)
  providerMessageId     String?                @map("provider_message_id") @db.VarChar(500)
  attemptCount          Int                    @default(0) @map("attempt_count")
  lastAttemptAt         DateTime?              @map("last_attempt_at")
  sentAt                DateTime?              @map("sent_at")
  failedAt              DateTime?              @map("failed_at")
  errorCode             String?                @map("error_code") @db.VarChar(100)
  errorMessage          String?                @map("error_message") @db.Text
  metadata              Json?
  manualRetryApprovedAt DateTime?              @map("manual_retry_approved_at")
  manualRetryConsumedAt DateTime?              @map("manual_retry_consumed_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  event                 Event?                 @relation(fields: [eventId], references: [id], onDelete: SetNull)
  household             Household?             @relation(fields: [householdId], references: [id], onDelete: SetNull)
  invitation            Invitation?            @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  rsvp                  Rsvp?                  @relation(fields: [rsvpId], references: [id], onDelete: SetNull)
  attempts              EmailDeliveryAttempt[]

  @@index([eventId, createdAt])
  @@index([invitationId, type, status])
  @@index([status, createdAt])
  @@index([status, manualRetryApprovedAt])
  @@map("email_logs")
}

model EmailDeliveryAttempt {
  id                String             @id @default(uuid()) @db.Uuid
  emailLogId        String             @map("email_log_id") @db.Uuid
  attemptNumber     Int                @map("attempt_number")
  status            EmailAttemptStatus @default(STARTED)
  providerMessageId String?            @map("provider_message_id") @db.VarChar(500)
  errorCode         String?            @map("error_code") @db.VarChar(100)
  errorMessage      String?            @map("error_message") @db.Text
  startedAt         DateTime           @default(now()) @map("started_at")
  completedAt       DateTime?          @map("completed_at")
  emailLog          EmailLog           @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  @@unique([emailLogId, attemptNumber])
  @@index([status, startedAt])
  @@map("email_delivery_attempts")
}

model AnalyticsEvent {
  id              String             @id @default(uuid()) @db.Uuid
  eventId         String             @map("event_id") @db.Uuid
  householdId     String?            @map("household_id") @db.Uuid
  invitationId    String?            @map("invitation_id") @db.Uuid
  rsvpId          String?            @map("rsvp_id") @db.Uuid
  type            AnalyticsEventType
  anonymousIdHash String?            @map("anonymous_id_hash") @db.Char(64)
  ipHash          String?            @map("ip_hash") @db.Char(64)
  userAgent       String?            @map("user_agent") @db.VarChar(512)
  metadata        Json?
  occurredAt      DateTime           @default(now()) @map("occurred_at")
  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  household       Household?         @relation(fields: [householdId], references: [id], onDelete: SetNull)
  invitation      Invitation?        @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  rsvp            Rsvp?              @relation(fields: [rsvpId], references: [id], onDelete: SetNull)

  @@index([eventId, type, occurredAt])
  @@index([invitationId, occurredAt])
  @@index([occurredAt])
  @@map("analytics_events")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  eventId    String?  @map("event_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  ipHash     String?  @map("ip_hash") @db.Char(64)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([eventId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
